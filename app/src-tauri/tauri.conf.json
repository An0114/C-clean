{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "C-Disk Cleaner",
  "version": "0.1.0",
  "identifier": "com.and0114.cclean",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "C-Disk Cleaner",
        "width": 900,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": [
      "../../rules/cache_rules.json",
      "../../rules/rules_meta.json",
      "../../scripts/scan_temp.ps1",
      "../../scripts/scan_windows_update.ps1",
      "../../scripts/scan_prefetch.ps1",
      "../../scripts/scan_browser_cache.ps1",
      "../../scripts/scan_dev_cache.ps1"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/An0114/C-clean/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzOUVBMURBQzhBMEFDNTIKUldSU3JLREkycUdlczlpUTExaUZnSmZWenFHb3Irc2FPVU02YmdIS0lkcWovWDNqV2ZoVG1lOGkK"
    }
  }
}
